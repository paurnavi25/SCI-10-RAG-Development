# ====================================================================
# Science AI Tutor - Environment Configuration Example
# ====================================================================
# Copy this file to .env in the backend folder and fill in your Gemini API key:
#   copy .env.example .env
#
# Obtain your free Gemini API key at:
#   https://aistudio.google.com/app/apikey
# ====================================================================

# Google Gemini API Key (Required for AI explanations and multimodal analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (Defaults to gemini-3.5-flash-lite; also supports gemini-2.5-flash)
GEMINI_MODEL=gemini-3.5-flash-lite
